<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest — required by App Store Connect since 2024-05-01.

	  This game is fully offline: it makes no network requests, has no
	  analytics/ads/crash SDK, and every save stays on device. So both the
	  tracking flag and the collected-data list are empty; the only entries
	  below are the "required reason" APIs our dependencies reach for.

	  Sources of each declared API:
	    FileTimestamp   — tauri-plugin-log rotates its log file (stat/mtime)
	    UserDefaults    — WKWebView (WebKit) and Tauri core read app-scoped defaults
	    DiskSpace       — WebKit checks free space before growing IndexedDB storage
	    SystemBootTime  — monotonic clocks behind Rust's std::time::Instant

	  If you add a plugin (fs, http, notifications…), re-check this list —
	  a missing reason code is an automatic upload rejection.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: timestamps of files inside the app container only. -->
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access limited to this app's own defaults. -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1: check free space before writing app data. -->
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 35F9.1: measure elapsed time for in-app events. -->
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
